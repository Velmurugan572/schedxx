# =====================================================================
# Sched Backend Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with real keys.
# =====================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Prisma connects via this link)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/sched_db?schema=public"

# Redis Cache & Queue Configuration
REDIS_URL="redis://localhost:6379"

# Security Secrets (Must be long random strings in production)
JWT_SECRET="super_secret_jwt_key_change_me_in_production"
ENCRYPTION_KEY="12345678901234567890123456789012" # 32-byte key for AES-256-GCM

# External Platform Integrations
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
LINKEDIN_CLIENT_ID="your_linkedin_client_id"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret"
X_API_KEY="your_x_api_key"
X_API_SECRET="your_x_api_secret"

# AI Integrations
GEMINI_API_KEY="your_google_gemini_api_key"
OPENAI_API_KEY="your_openai_api_key"
